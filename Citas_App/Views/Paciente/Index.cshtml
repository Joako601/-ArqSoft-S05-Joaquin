@model List<Citas_App.Models.Paciente>
<h1>Pacientes registrados</h1>
<table border="1" cellpadding="8">
    <tr>
        <th>Nombre</th>
        <th>Email</th>
        <th>Teléfono</th>
        <th></th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nombre @p.Apellido</td>
            <td>@p.Email</td>
            <td>@p.Telefono</td>
            <td><a asp-action="Detalle" asp-route-id="@p.Id">Ver detalle</a></td>
        </tr>
    }
</table>
<p>
    <a asp-action="Crear" class="btn btn-primary" style="padding: 10px; background-color: #0d6efd; color: white; text-decoration: none; border-radius: 5px;">
        Agregar Paciente
    </a>
</p>