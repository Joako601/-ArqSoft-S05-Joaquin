@model Citas_App.Models.Medico

<h1>Agregar Nuevo Médico</h1>

<form asp-action="Crear" method="post" style="max-width: 400px; margin-top: 20px;">
    <div style="margin-bottom: 10px;">
        <label>Nombre:</label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Apellido:</label>
        <input asp-for="Apellido" class="form-control" required />
    </div>

    <div style="margin-bottom: 10px;">
        <label>Especialidad:</label>
        <input asp-for="Especialidad" class="form-control" required />
    </div>

    <button type="submit" style="padding: 10px 20px; background-color: #198754; color: white; border: none; border-radius: 5px; cursor: pointer;">
        Guardar Médico
    </button>
    <a asp-action="Index" style="margin-left: 10px; text-decoration: none;">Cancelar</a>
</form>