@model List<Citas_App.Domain.Models.Cita>

<link rel="stylesheet" href="~/css/agenda.css" />

@{
    
    var pacientes = ViewBag.Pacientes as List<Citas_App.Domain.Models.Paciente> ?? new List<Citas_App.Domain.Models.Paciente>();
    var medicos = ViewBag.Medicos as List<Citas_App.Domain.Models.Medico> ?? new List<Citas_App.Domain.Models.Medico>();
}

<div style="background-color: var(--doc-gray); padding: 40px 20px; min-height: 100vh;">

    <div style="max-width: 1100px; margin: 0 auto;">

      
        <div class="animate-up" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <div>
                <h1 style="color: var(--doc-dark); font-weight: 700; margin: 0; font-size: 28px;">Agenda General</h1>
                <p style="color: #707b8e; margin: 5px 0 0 0; font-size: 15px;">Control de citas</p>
            </div>
           
        </div>


        <div class="doc-card animate-up delay-1">

            @if (Model.Count == 0)
            {
                <div style="text-align: center; padding: 60px 20px; color: #707b8e;">
                    <div style="font-size: 40px; margin-bottom: 15px;">📅</div>
                    <h3 style="color: var(--doc-dark); margin-bottom: 10px;">Agenda vacía</h3>
                    <p>No hay citas programadas en este momento.</p>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="doc-table">
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Paciente</th>
                            <th>Especialista</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                        </tr>

                       
                        @foreach (var c in Model.OrderBy(x => x.Fecha).ThenBy(x => x.Hora))
                        {
                           
                            var paciente = pacientes.FirstOrDefault(p => p.Id == c.PacienteId);
                            var medico = medicos.FirstOrDefault(m => m.Id == c.MedicoId);

                            <tr>
                              
                                <td>
                                    <div style="font-weight: 700; color: var(--doc-dark); font-size: 15px;">
                                        @c.Fecha.ToString("dd MMM yyyy")
                                    </div>
                                    <div style="color: var(--doc-teal); font-size: 13px; font-weight: 600; margin-top: 3px;">
                                        🕒 @c.Hora.ToString("HH:mm") hrs
                                    </div>
                                </td>

                                <td>
                                    <div style="font-weight: 600; color: var(--doc-dark);">
                                        @(paciente != null ? $"{paciente.Nombre} {paciente.Apellido}" : "—")
                                    </div>
                                </td>

                               
                                <td>
                                    <div style="color: #475569; font-weight: 500;">
                                        @(medico != null ? $"Dr. {medico.Nombre} {medico.Apellido}" : "—")
                                    </div>
                                </td>

                                
                                <td style="color: #64748b;">@c.Motivo</td>

                              
                                <td>
                                    @if (c.Estado == "Completada")
                                    {
                                        <span class="status-badge" style="background: #e6f6f4; color: #00b39b;">@c.Estado</span>
                                    }
                                    else if (c.Estado == "Cancelada")
                                    {
                                        <span class="status-badge" style="background: #feeef0; color: #e83e8c;">@c.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge" style="background: #eef2ff; color: #4361ee;">@c.Estado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            }
        </div>
    </div>
</div>