@model Citas_App.Domain.Models.Paciente

<link rel="stylesheet" href="~/css/agenda.css" />

<div style="background-color: var(--doc-gray); padding: 40px 20px; min-height: 100vh;">

    <div style="max-width: 1000px; margin: 0 auto;">

        <div class="animate-up" style="display: flex; justify-content: space-between; align-items: center;">
            <a asp-controller="Paciente" asp-action="Index" class="doc-btn doc-btn-outline" style="padding: 8px 18px; font-size: 14px; border-radius: 8px;">
                ← Volver al directorio
            </a>
            <span style="color: #707b8e; font-size: 14px; font-weight: 500;">Historial Clínico Activo</span>
        </div>

        <div class="detail-layout">

            <div class="sidebar-profile animate-up delay-1">
                <div class="avatar-large">
                    @Model.Nombre?.FirstOrDefault()@Model.Apellido?.FirstOrDefault()
                </div>
                <h2 style="margin: 0; font-size: 22px; color: var(--doc-dark); font-weight: 700;">
                    @Model.Nombre @Model.Apellido
                </h2>
                <span class="patient-badge">ID Paciente: #@Model.Id</span>
            </div>

            <div class="main-medical-info animate-up delay-2">

                <div class="info-block">
                    <h3 class="block-title">📂 Información Personal</h3>

                    <div class="data-grid">
                        <div class="data-item">
                            <span class="data-label">Nombre Completo</span>
                            <span class="data-value">@Model.Nombre @Model.Apellido</span>
                        </div>

                        <div class="data-item">
                            <span class="data-label">Número de Teléfono</span>
                            <span class="data-value">📱 @Model.Telefono</span>
                        </div>

                        <div class="data-item">
                            <span class="data-label">Correo Electrónico</span>
                            <span class="data-value" style="color: var(--doc-teal);">✉️ @Model.Email</span>
                        </div>
                    </div>
                </div>

                <div class="info-block">
                    <h3 class="block-title">🩺 Notas Médicas Generales</h3>
                    <p style="color: #64748b; margin: 0; font-size: 15px; line-height: 1.6;">
                        Paciente registrado correctamente en el sistema de la clínica. Cuenta con acceso activo para la gestión de citas de control y consultas de especialidades básicas. Sin alergias severas reportadas en la primera entrevista de recepción.
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>