<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediGest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />

    <style>
            
            .navbar-brand {
                color: var(--doc-teal) !important;
                font-weight: 800;
                font-size: 24px;
                letter-spacing: -0.5px;
            }

            .nav-link {
                font-weight: 500;
                color: #475569 !important;
                transition: color 0.2s;
            }

                .nav-link:hover {
                    color: var(--doc-teal) !important;
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow" style="padding: 15px 20px;">
            <div class="container-fluid" style="max-width: 1200px;">

               
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">MediGest+</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                   
                    <ul class="navbar-nav flex-grow-1 ms-4">
                       
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Agendar" asp-action="Index">Panel Central</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cita" asp-action="Index">Citas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Paciente" asp-action="Index">Pacientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Medico" asp-action="Index">Médicos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

   
    <main role="main">
        @RenderBody()
    </main>

    
    <footer class="border-top footer bg-white" style="padding: 20px 0; color: #707b8e; font-size: 14px;">
        <div class="container" style="max-width: 1200px; text-align: center;">
            &copy; 2026 MediGest App - Sistema de Gestión Médica | <a asp-controller="Home" asp-action="Privacy" style="color: var(--doc-teal); text-decoration: none; font-weight: 600;">Políticas de Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>